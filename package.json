{
  "name": "zhiyu",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "pnpm dev:deps && pnpm --filter web start",
    "dev": "pnpm dev:deps && pnpm --filter web dev",
    "dev:safe": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-start.ps1 -Clean",
    "dev:deps": "node ./scripts/start-local-deps.cjs",
    "dev:web": "pnpm --filter web dev",
    "dev:all": "pnpm -r --parallel dev",
    "test": "pnpm --filter web test",
    "tsc": "pnpm --filter web tsc",
    "build": "pnpm --filter web build",
    "db:migrate": "pnpm --filter web db:migrate",
    "build:with-migrations": "pnpm --filter web build:with-migrations",
    "build:packages": "cross-env NODE_OPTIONS=--max-old-space-size=4096 pnpm -r --filter='./packages/*' build",
    "build:all": "pnpm -r build",
    "db:brain:check": "pnpm --filter web db:brain:check",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "clean": "pnpm -r --if-present clean"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "baseline-browser-mapping": "^2.10.0",
    "puppeteer": "^24.38.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.6",
      "@whiskeysockets/libsignal-node": "git+https://github.com/WhiskeySockets/libsignal-node.git#1c30d7d7e76a3b0aa120b04dc6a26f5a12dccf67"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "protobufjs",
      "sqlite-vec",
      "sqlite3"
    ],
    "ignoredBuiltDependencies": [
      "@biomejs/biome",
      "bufferutil",
      "core-js",
      "es5-ext",
      "esbuild",
      "msw",
      "puppeteer",
      "sharp",
      "utf-8-validate"
    ]
  },
  "dependencies": {
    "@chroma-core/default-embed": "^0.1.9",
    "better-sqlite3": "^11.10.0"
  }
}
