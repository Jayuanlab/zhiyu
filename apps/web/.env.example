# Core application secrets
# Generate each value with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace-with-random-secret
ENCRYPTION_KEY=replace-with-32-byte-base64url-key

# Local PostgreSQL created by scripts/start-local-deps.cjs
POSTGRES_URL=postgres://openzhiyu:openzhiyu@127.0.0.1:5432/openzhiyu

# Main OpenAI-compatible language model
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=replace-with-provider-key
LLM_MODEL=replace-with-model-id
# LLM_VISION_LANGUAGE_MODEL=replace-with-vision-model-id
# LLM_IMAGE_MODEL=replace-with-image-model-id

# Optional Claude Agent SDK provider
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_API_KEY=replace-with-provider-key
# ANTHROPIC_MODEL=replace-with-model-id

# Workshop and Loop planning. Defaults to the main LLM settings when omitted.
# WORKSHOP_PLANNER_LLM_BASE_URL=https://your-provider.example/v1
# WORKSHOP_PLANNER_LLM_API_KEY=replace-with-provider-key
# WORKSHOP_PLANNER_LLM_MODEL=replace-with-model-id
# LOOP_NL_LLM_BASE_URL=https://your-provider.example/v1
# LOOP_NL_LLM_API_KEY=replace-with-provider-key
# LOOP_NL_LLM_MODEL=replace-with-model-id

# Interaction-to-memory processing. Keep this model economical because it runs
# frequently over short batches.
# INTERACTION_PROCESSOR_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# INTERACTION_PROCESSOR_LLM_API_KEY=replace-with-provider-key
# INTERACTION_PROCESSOR_LLM_MODEL=qwen-flash

# Brain migration mode: brain_first, brain_only, or legacy_first.
BRAIN_MEMORY_MODE=brain_first

# Embeddings. Configure either a cloud provider or the local backend.
EMBEDDING_PROVIDER=cloud
LLM_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_EMBEDDINGS_API_KEY=replace-with-embedding-key
LLM_EMBEDDING_MODEL=text-embedding-v4
LLM_EMBEDDING_DIMENSIONS=1024
# EMBEDDING_PROVIDER=local
# LOCAL_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# LOCAL_EMBEDDING_CACHE_DIR=.openzhiyu/models
# LOCAL_EMBEDDING_DEVICE=cpu

# Vector storage. PostgreSQL remains the source of truth.
VECTOR_STORE_BACKEND=sqlite-vec
# VECTOR_STORE_BACKEND=chroma
# CHROMA_URL=http://127.0.0.1:8000
# CHROMA_RAG_COLLECTION=openzhiyu_rag_chunks
# CHROMA_RAW_MESSAGES_COLLECTION=openzhiyu_raw_messages
# CHROMA_INSIGHTS_COLLECTION=openzhiyu_insights

# Local scheduler and Harness evolution
ENABLE_LOCAL_SCHEDULER=true
WORK_HARNESS_EVOLUTION_ENABLED=false

# Embedded quant Python worker (started on demand by Web)
# QUANT_PYTHON_BIN=D:/zhiyu/tools/quant-service/.venv/Scripts/python.exe
# QUANT_TRANSPORT=http and QUANT_SERVICE_URL=... are for isolated HTTP fixtures only.
# QUANT_DIRECT_ACCOUNT_TIMEOUT_MS=5000
QUANT_DATA_PROVIDER=auto
QUANT_AKSHARE_SOURCE=sina
QUANT_CANDIDATE_PROVIDER=tencent
# OPENZHIYU_SKIP_QUANT=1

# WeChat desktop automation service
WECHAT_DESKTOP_SERVICE_URL=http://127.0.0.1:8765
# WECHAT_DESKTOP_TOKEN=replace-with-local-service-token
# WECHAT_DESKTOP_DEFAULT_RECIPIENT=replace-with-contact-name
# WECHAT_DESKTOP_ALLOWED_RECIPIENTS=contact-a,contact-b
# OPENZHIYU_SKIP_WECHAT=1

# Optional external wx CLI for local history reads
# WECHAT_LOCAL_WX_BINARY=C:\\path\\to\\wx.exe
# WECHAT_LOCAL_TIMEOUT_MS=120000

# Optional search, audio, and video providers
# Web search prefers Bailian when a Bailian key is configured, then Brave, then DuckDuckGo.
# BAILIAN_WEB_SEARCH_API_KEY=replace-with-bailian-key
# BRAVE_SEARCH_API_KEY=replace-with-brave-key
# OPENAI_API_KEY=replace-with-audio-key
# OPENAI_AUDIO_BASE_URL=https://api.openai.com/v1
# Use a genuine Bailian key for Bailian-only APIs; do not alias an OpenCode key.
# DASHSCOPE_API_KEY=replace-with-bailian-key
# BAILIAN_VIDEO_API_KEY=replace-with-bailian-key
# BAILIAN_VIDEO_MODEL=replace-with-video-model-id

# Optional object storage and cache
# Pi execution adapter for new runs: harness (default), or agent for rollback.
# PI_RUNTIME_ADAPTER=harness
# BLOB_READ_WRITE_TOKEN=replace-with-blob-token
# REDIS_URL=redis://127.0.0.1:6379

# Local development identity. Do not use in production.
# DEV_AUTH_USER_ID=local-owner
# NEXT_PUBLIC_APP_URL=http://127.0.0.1:3515

# Local dependency startup controls
# OPENZHIYU_SKIP_POSTGRES=1
# OPENZHIYU_SKIP_DOCKER_DESKTOP_START=1
# DOCKER_CLI_PATH=C:\\Program Files\\Docker\\Docker\\resources\\bin\\docker.exe
# DOCKER_DESKTOP_PATH=C:\\Program Files\\Docker\\Docker\\Docker Desktop.exe

# Optional Jev evidence checks: off | shadow | active. Start with shadow.
BRAIN_JEV_MODE=off
# Replace generative Brain planning and prefetch authorized Pi platform reads: off | replace.
# For latency replacement, keep BRAIN_JEV_MODE=off (evidence checking is additive).
BRAIN_JEV_ROUTING=off
# One conditional architecture expansion before generation, gated by Jev coverage.
BRAIN_JEV_TARGETED_RETRY=false
TYPESAFE_API_KEY=

# Computer Use upstream runners (both services listen on loopback).
# CUA_JAVASCRIPT_URL=http://127.0.0.1:4001
# CUA_PYTHON_URL=http://127.0.0.1:4041
# Set OPENAI_API_KEY in the upstream runner environment, not in browser code.
